    {
      "parameters": {
        "jsCode": "// Normalize Shopify order: turns the Shopify order payload into one tidy row.\n// Edit the fields below to add or remove columns (the sheet header must match).\nconst money = (v) => { const n = parseFloat(v); return Number.isFinite(n) ? Math.round(n * 100) / 100 : 0; };\nreturn $input.all().map((item, i) => {\n  const o = item.json;\n  const c = o.customer || {};\n  const items = (o.line_items || []).map((li) => `${li.quantity}x ${li.name || li.title}${li.sku ? ' [' + li.sku + ']' : ''}`);\n  return {\n    json: {\n      order_key: `shopify:${o.id}`,\n      order_number: o.name || String(o.order_number || o.id),\n      order_date: new Date(o.created_at || Date.now()).toISOString(),\n      customer_name: [c.first_name, c.last_name].filter(Boolean).join(' ') || (o.billing_address && o.billing_address.name) || '',\n      customer_email: o.email || o.contact_email || c.email || '',\n      currency: o.currency || '',\n      total: money(o.total_price),\n      items_summary: items.join('; '),\n      financial_status: o.financial_status || '',\n      is_test: o.test === true,\n      logged_at: new Date().toISOString(),\n    },\n    pairedItem: { item: i },\n  };\n});\n"
      },
      "id": "fa374d76-eb53-54e9-b4ed-da7f38af9f79",
      "name": "Normalize Shopify order",
